{
  "name": "@serggrey1992/react-form-builder",
  "version": "0.1.0",
  "description": "UI agnostic, type-safe React Hook Form builder with named slots",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepack": "npm run build",
    "test:consumer": "node scripts/test-consumer.mjs",
    "prepare:examples": "npm pack"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-hook-form": ">=7.66.0 <8"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hookform/resolvers": "^5.9.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.66.0",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "zod": "^3.25.76"
  },
  "author": "Sergey Grey",
  "keywords": [
    "react",
    "react-hook-form",
    "form",
    "form-builder",
    "typescript",
    "slots"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SergGrey1992/react-form-builder.git"
  },
  "homepage": "https://github.com/SergGrey1992/react-form-builder#readme",
  "bugs": {
    "url": "https://github.com/SergGrey1992/react-form-builder/issues"
  }
}
